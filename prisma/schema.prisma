datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Song {
  id           String   @id @default(cuid())
  prompt       String
  lyrics       String?
  instrumental Boolean  @default(true)
  autoLyrics   Boolean  @default(false)
  model        String   @default("music-2.5+")
  audioUrl     String?
  status       String   @default("pending")
  errorMessage String?
  rawResponse  String?
  createdAt    DateTime @default(now())
}
